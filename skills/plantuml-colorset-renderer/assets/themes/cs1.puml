' Native family scopes prevent generic styles from overriding unrelated roles.
<style>
root {
  BackGroundColor #ffffff
  FontColor #000000
  LineColor #696969
  Padding 6
}
document {
  BackGroundColor #ffffff
  FontColor #000000
  LineColor #ffffff
  title {
    BackGroundColor transparent
    LineColor transparent
    FontColor #000000
    LineThickness 0
  }
  header, footer, caption {
    FontColor #000000
    BackGroundColor transparent
  }
  legend {
    BackGroundColor #ffffff
    FontColor #000000
    LineColor transparent
    LineThickness 0
  }
}
arrow {
  BackGroundColor #696969
  FontColor #000000
  LineColor #696969
  LineThickness 1.5
}
actor, boundary, control {
  BackGroundColor #ffffff
  FontColor #000000
  LineColor #333e48
  LineThickness 1.5
}
node, artifact, folder, frame, rectangle, card {
  BackGroundColor #9e1b32
  FontColor #ffffff
  LineColor #9e1b32
  LineThickness 0
}
component {
  BackGroundColor #9e1b32
  FontColor #ffffff
  LineColor #9e1b32
  LineThickness 0
}
