' Native family scopes prevent generic styles from overriding unrelated roles.
<style>
root {
  BackGroundColor #ffffff
  FontColor #000000
  LineColor #696969
  Padding 6
}
document {
  BackGroundColor #ffffff
  FontColor #000000
  LineColor #ffffff
  title {
    BackGroundColor transparent
    LineColor transparent
    FontColor #000000
    LineThickness 0
  }
  header, footer, caption {
    FontColor #000000
    BackGroundColor transparent
  }
  legend {
    BackGroundColor #ffffff
    FontColor #000000
    LineColor transparent
    LineThickness 0
  }
}
arrow {
  BackGroundColor #696969
  FontColor #000000
  LineColor #696969
  LineThickness 1.5
}
actor, boundary, control {
  BackGroundColor #ffffff
  FontColor #000000
  LineColor #333e48
  LineThickness 1.5
}
node, artifact, folder, frame, rectangle, card {
  BackGroundColor #1c1c1c
  FontColor #ffffff
  LineColor #1c1c1c
  LineThickness 0
}
component {
  BackGroundColor #9c9c9c
  FontColor #000000
  LineColor #9c9c9c
  LineThickness 0
}
interface {
  BackGroundColor #b5b5b5
  FontColor #000000
  LineColor #b5b5b5
  LineThickness 0
}
database, storage, collections {
  BackGroundColor #363636
  FontColor #ffffff
  LineColor #363636
  LineThickness 0
}
cloud {
  BackGroundColor #000000
  FontColor #ffffff
  LineColor #000000
  LineThickness 0
}
queue {
  BackGroundColor #cfcfcf
  FontColor #000000
  LineColor #cfcfcf
  LineThickness 0
}
agent, participant {
  BackGroundColor #333e48
  FontColor #ffffff
  LineColor #333e48
  LineThickness 0
}
class {
  BackGroundColor #828282
  FontColor #000000
  LineColor #828282
  LineThickness 0
}
object {
  BackGroundColor #e8002a
  FontColor #ffffff
  LineColor #e8002a
  LineThickness 0
}
usecase {
  BackGroundColor #6d1222
  FontColor #ffffff
  LineColor #6d1222
  LineThickness 0
}
note {
  BackGroundColor #9e1b32
  FontColor #ffffff
  LineColor #9e1b32
  LineThickness 0
}
activity {
  BackGroundColor #4f4f4f
  FontColor #ffffff
  LineColor #4f4f4f
  LineThickness 0
}
state {
  BackGroundColor #e7e7e7
  FontColor #000000
  LineColor #e7e7e7
  LineThickness 0
}
classDiagram, componentDiagram, objectDiagram {
  group, composite {
    BackGroundColor #e7e7e7
    FontColor #000000
    LineColor #e7e7e7
    LineThickness 0
    title { FontColor #000000 }
  }
}
objectDiagram {
  object {
    BackGroundColor #e8002a
    FontColor #ffffff
    LineColor #e8002a
    LineThickness 0
  }
}
componentDiagram {
  usecase {
    BackGroundColor #6d1222
    FontColor #ffffff
    LineColor #6d1222
    LineThickness 0
  }
}
sequenceDiagram {
  participant {
    BackGroundColor #333e48
    FontColor #ffffff
    LineColor #333e48
    LineThickness 0
  }
  actor, boundary, control, entity {
    BackGroundColor #ffffff
    FontColor #000000
    LineColor #333e48
    LineThickness 1.5
  }
  database {
    FontColor #000000
  }
  queue {
    BackGroundColor #cfcfcf
    FontColor #000000
    LineColor #cfcfcf
    LineThickness 0
  }
  collections {
    BackGroundColor #363636
    FontColor #ffffff
    LineColor #363636
    LineThickness 0
  }
  lifeLine {
    LineColor #696969
    LineThickness 1
  }
  activationBox {
    BackGroundColor #e7e7e7
    FontColor #000000
    LineColor #696969
    LineThickness 1
  }
  group, groupHeader, reference, referenceHeader, box, separator {
    BackGroundColor #e7e7e7
    FontColor #000000
    LineColor #696969
    LineThickness 1
  }
}
activityDiagram {
  activity {
    BackGroundColor #4f4f4f
    FontColor #ffffff
    LineColor #4f4f4f
    LineThickness 0
  }
  diamond {
    BackGroundColor #696969
    FontColor #ffffff
    LineColor #696969
    LineThickness 0
  }
  composite, partition, swimlane {
    BackGroundColor #e7e7e7
    FontColor #000000
    LineColor #696969
    LineThickness 1
  }
  circle {
    start {
      BackGroundColor #333e48
      FontColor #ffffff
      LineColor #333e48
      LineThickness 1
    }
    stop, end {
      BackGroundColor #e8002a
      FontColor #ffffff
      LineColor #e8002a
      LineThickness 1.5
    }
  }
  activityBar {
    BackGroundColor #333e48
    FontColor #ffffff
    LineColor #333e48
    LineThickness 1.5
  }
  arrow {
    FontColor #000000
    LineColor #696969
    LineThickness 1.5
  }
}
stateDiagram {
  state {
    BackGroundColor #e7e7e7
    FontColor #000000
    LineColor #e7e7e7
    LineThickness 0
  }
  group {
    BackGroundColor #e7e7e7
    FontColor #000000
    LineColor #696969
    LineThickness 1
  }
  circle {
    start {
      BackGroundColor #333e48
      FontColor #ffffff
      LineColor #333e48
      LineThickness 1
    }
    stop, end {
      BackGroundColor #e8002a
      FontColor #ffffff
      LineColor #e8002a
      LineThickness 1.5
    }
  }
}
mindmapDiagram, wbsDiagram {
  node {
    BackGroundColor #9e1b32
    FontColor #ffffff
    LineColor #9e1b32
    LineThickness 0
  }
  arrow {
    FontColor #000000
    LineColor #696969
    LineThickness 1.5
  }
}
jsonDiagram, yamlDiagram {
  node {
    BackGroundColor #1c1c1c
    FontColor #ffffff
    LineColor #1c1c1c
    LineThickness 0
    separator {
      LineColor #ffffff
      LineThickness 1
    }
    highlight {
      BackGroundColor #e7e7e7
      FontColor #000000
      LineColor #e7e7e7
      LineThickness 0
    }
  }
  arrow {
    FontColor #000000
    LineColor #696969
    LineThickness 1.5
  }
}
packetdiagDiagram {
  rectangle {
    BackGroundColor #9e1b32
    FontColor #ffffff
    LineColor #ffffff
    LineThickness 1
  }
}
chenEerDiagram {
  chenEntity {
    BackGroundColor #9e1b32
    FontColor #ffffff
    LineColor #9e1b32
    LineThickness 0
    .weak {
      LineColor #ffffff
      LineThickness 1.5
    }
  }
  chenAttribute {
    BackGroundColor #333e48
    FontColor #ffffff
    LineColor #333e48
    LineThickness 0
    .multi, .derived {
      LineColor #ffffff
      LineThickness 1.5
    }
  }
  chenRelationship {
    BackGroundColor #6d1222
    FontColor #ffffff
    LineColor #6d1222
    LineThickness 0
    .identifying {
      LineColor #ffffff
      LineThickness 1.5
    }
  }
}
nwdiagDiagram {
  server {
    BackGroundColor #333e48
    FontColor #ffffff
    LineColor #333e48
    LineThickness 0
  }
  network {
    BackGroundColor #cfcfcf
    FontColor #000000
    LineColor #696969
    LineThickness 1
  }
  group {
    BackGroundColor #e7e7e7
    FontColor #000000
    LineColor #e7e7e7
    LineThickness 0
  }
  arrow {
    FontColor #000000
    LineColor #696969
    LineThickness 1.5
  }
}
' Railroad strokes encode grammar: native token outline widths are hard-coded.
ebnf {
  BackGroundColor #828282
  FontColor #000000
  LineColor #696969
  LineThickness 1.5
}
ganttDiagram {
  task {
    BackGroundColor #828282
    FontColor #000000
    LineColor #828282
    LineThickness 0
    unstarted {
      BackGroundColor #828282
      FontColor #000000
      LineColor #828282
      LineThickness 0
    }
  }
  undone {
    BackGroundColor #e7e7e7
    FontColor #000000
    LineColor #e7e7e7
    LineThickness 0
  }
  timeline {
    BackGroundColor #ffffff
    FontColor #000000
    LineColor #696969
    LineThickness 1
  }
  closed {
    BackGroundColor #e7e7e7
    FontColor #000000
    LineColor #e7e7e7
    LineThickness 0
  }
  milestone {
    BackGroundColor #333e48
    FontColor #000000
    LineColor #333e48
    LineThickness 1
  }
  separator {
    BackGroundColor transparent
    FontColor #000000
    LineColor #696969
    LineThickness 1
  }
}
timingDiagram {
  FontColor #000000
  LineColor #696969
  LineThickness 1
  robust {
    BackGroundColor #9e1b32
    FontColor #000000
    LineColor #9e1b32
    LineThickness 2
  }
  concise {
    BackGroundColor #828282
    FontColor #000000
    LineColor #828282
    LineThickness 1.5
  }
  binary, clock {
    FontColor #000000
    LineColor #9e1b32
    LineThickness 1.5
  }
  arrow, constraintArrow {
    FontColor #000000
    LineColor #696969
    LineThickness 1.5
  }
  timeline {
    FontColor #000000
    LineColor #696969
    LineThickness 1.5
  }
}
chartDiagram {
  BackGroundColor #ffffff
  FontColor #000000
  LineColor #ffffff
  axis {
    FontColor #000000
    LineColor #696969
    LineThickness 1
  }
  grid {
    LineColor #e7e7e7
    LineThickness 1
  }
  bar {
    BackGroundColor #9e1b32
    FontColor #ffffff
    LineColor #9e1b32
    LineThickness 0
  }
  line {
    LineColor #333e48
    LineThickness 1.5
  }
  scatter {
    MarkerColor #6d1222
  }
}
filesDiagram, saltDiagram {
  FontColor #000000
  LineColor #696969
  LineThickness 1
}
</style>
