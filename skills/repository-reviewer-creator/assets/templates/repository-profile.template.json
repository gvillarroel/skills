    "revision": "{{REVISION_OR_SNAPSHOT}}",
    "inspected_at": "{{YYYY_MM_DD}}",
    "fingerprint_paths": ["{{PROJECT_MANIFEST_PATH}}"]
  },
  "sources": [
    {
      "id": "source-1",
      "kind": "{{RESOURCE_CLASS}}",
