---
# mermaid: config begin
config:
  theme: "base"
  themeVariables:
    background: "#ffffff"
    primaryColor: "#9e1b32"
    primaryTextColor: "#ffffff"
    primaryBorderColor: "#9e1b32"
    secondaryColor: "#000000"
    secondaryTextColor: "#ffffff"
    secondaryBorderColor: "#000000"
    tertiaryColor: "#828282"
    tertiaryTextColor: "#000000"
    tertiaryBorderColor: "#828282"
    lineColor: "#696969"
    textColor: "#333e48"
    mainBkg: "#9e1b32"
    nodeBkg: "#9e1b32"
    nodeBorder: "#9e1b32"
    clusterBkg: "#e7e7e7"
    clusterBorder: "#9c9c9c"
    defaultLinkColor: "#696969"
    edgeLabelBackground: "#ffffff"
    labelColor: "#ffffff"
    titleColor: "#333e48"
  themeCSS: ".node > rect, .node > circle, .node > ellipse, .node > polygon, .node > path, rect.actor, .note, .task, .task0, .task1, .task2, .task3 { stroke-width: 0 !important; }"
  er:
    minEntityWidth: 180
    rankSpacing: 80
    entityPadding: 6
    diagramPadding: 6
    nodeSpacing: 60
# mermaid: config end
# mermaid: metadata begin
mermaid:
  colorset: "colorset1"
  mode: "standard"
  palette: "basic-red-neutral-style"
# mermaid: metadata end
---
erDiagram
  accTitle: Entity Relationship maximum complexity showcase
  accDescr: Nine entities form eight ordered one-to-many relationships and expose every semantic class available to the styler.
  ENTITY_01 ||--o{ ENTITY_02 : relates
  ENTITY_02 ||--o{ ENTITY_03 : relates
  ENTITY_03 ||--o{ ENTITY_04 : relates
  ENTITY_04 ||--o{ ENTITY_05 : relates
  ENTITY_05 ||--o{ ENTITY_06 : relates
  ENTITY_06 ||--o{ ENTITY_07 : relates
  ENTITY_07 ||--o{ ENTITY_08 : relates
  ENTITY_08 ||--o{ ENTITY_09 : relates
  class ENTITY_01 csPrimary
  class ENTITY_02 csAccent
  class ENTITY_03 csMuted
  class ENTITY_04 csCritical
  class ENTITY_05 csWarning
  class ENTITY_06 csSuccess
  class ENTITY_07 csInfo
  class ENTITY_08 csSpecial
  class ENTITY_09 csNeutral
  classDef csPrimary fill:#9e1b32,stroke:none,color:#ffffff,stroke-width:0px;
  classDef csAccent fill:#000000,stroke:none,color:#ffffff,stroke-width:0px;
  classDef csMuted fill:#828282,stroke:none,color:#000000,stroke-width:0px;
  classDef csCritical fill:#1c1c1c,stroke:none,color:#ffffff,stroke-width:0px;
  classDef csWarning fill:#9c9c9c,stroke:none,color:#000000,stroke-width:0px;
  classDef csSuccess fill:#363636,stroke:none,color:#ffffff,stroke-width:0px;
  classDef csInfo fill:#b5b5b5,stroke:none,color:#000000,stroke-width:0px;
  classDef csSpecial fill:#333e48,stroke:none,color:#ffffff,stroke-width:0px;
  classDef csNeutral fill:#cfcfcf,stroke:none,color:#000000,stroke-width:0px;
