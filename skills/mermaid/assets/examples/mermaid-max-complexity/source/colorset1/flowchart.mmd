---
flowchart LR
  accTitle: Flowchart maximum complexity showcase
  accDescr: Nine styled process roles form an ordered validation path from the primary entry through the neutral terminal role.
  R01["Flow role 01"]:::csPrimary --> R02["Flow role 02"]:::csAccent
  R02 --> R03["Flow role 03"]:::csMuted
  R03 --> R04["Flow role 04"]:::csCritical
  R04 --> R05["Flow role 05"]:::csWarning
  R05 --> R06["Flow role 06"]:::csSuccess
  R06 --> R07["Flow role 07"]:::csInfo
  R07 --> R08["Flow role 08"]:::csSpecial
  R08 --> R09["Flow role 09"]:::csNeutral
  classDef csPrimary fill:#ffccd5,stroke:#9e1b32,color:#333e48,stroke-width:2px;
  classDef csAccent fill:#e7e7e7,stroke:#4f4f4f,color:#333e48,stroke-width:2px;
  classDef csMuted fill:#e7e7e7,stroke:#828282,color:#333e48,stroke-width:2px;
  classDef csCritical fill:#ffccd5,stroke:#e8002a,color:#333e48,stroke-width:2px;
  classDef csWarning fill:#e7e7e7,stroke:#828282,color:#333e48,stroke-width:2px;
  classDef csSuccess fill:#cfcfcf,stroke:#333e48,color:#333e48,stroke-width:2px;
  classDef csInfo fill:#ffccd5,stroke:#9e1b32,color:#333e48,stroke-width:2px;
  classDef csSpecial fill:#e7e7e7,stroke:#696969,color:#333e48,stroke-width:2px;
  classDef csNeutral fill:#e7e7e7,stroke:#333e48,color:#333e48,stroke-width:2px;
