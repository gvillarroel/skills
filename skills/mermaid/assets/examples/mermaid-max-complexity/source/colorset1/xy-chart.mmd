---
# mermaid: config begin
config:
  theme: "base"
  themeVariables:
    background: "#ffffff"
    primaryColor: "#9e1b32"
    primaryTextColor: "#ffffff"
    primaryBorderColor: "#9e1b32"
    secondaryColor: "#333e48"
    secondaryTextColor: "#ffffff"
    secondaryBorderColor: "#333e48"
    tertiaryColor: "#4f4f4f"
    tertiaryTextColor: "#ffffff"
    tertiaryBorderColor: "#4f4f4f"
    lineColor: "#696969"
    textColor: "#333e48"
    mainBkg: "#9e1b32"
    nodeBkg: "#9e1b32"
    nodeBorder: "#9e1b32"
    clusterBkg: "#e7e7e7"
    clusterBorder: "#9c9c9c"
    defaultLinkColor: "#696969"
    edgeLabelBackground: "#ffffff"
    labelColor: "#ffffff"
    titleColor: "#333e48"
    xyChart:
      backgroundColor: "#ffffff"
      titleColor: "#333e48"
      xAxisLabelColor: "#333e48"
      xAxisTitleColor: "#333e48"
      xAxisTickColor: "#696969"
      xAxisLineColor: "#696969"
      yAxisLabelColor: "#333e48"
      yAxisTitleColor: "#333e48"
      yAxisTickColor: "#696969"
      yAxisLineColor: "#696969"
      plotColorPalette: "#9e1b32, #4f4f4f, #828282, #333e48, #696969"
  themeCSS: ".node > rect, .node > circle, .node > ellipse, .node > polygon, .node > path, rect.actor, .note, .task, .task0, .task1, .task2, .task3 { stroke-width: 0 !important; }"
# mermaid: config end
# mermaid: metadata begin
mermaid:
  colorset: "colorset1"
  mode: "standard"
  palette: "basic-red-neutral-style"
# mermaid: metadata end
---
xychart
  accTitle: XY Chart maximum complexity showcase
  accDescr: Six alternating bar and line series increase across four categories and expose the extended palette tail and standard palette cycle.
  title "XY configured palette capacity"
  x-axis [A, B, C, D]
  y-axis "Value" 0 --> 12
  bar [1, 2, 3, 4]
  line [2, 3, 4, 5]
  bar [3, 4, 5, 6]
  line [4, 5, 6, 7]
  bar [5, 6, 7, 8]
  line [6, 7, 8, 9]
