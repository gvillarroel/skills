---
# mermaid: config begin
config:
  theme: "base"
  themeVariables:
    background: "#ffffff"
    primaryColor: "#9e1b32"
    primaryTextColor: "#ffffff"
    primaryBorderColor: "#9e1b32"
    secondaryColor: "#333e48"
    secondaryTextColor: "#ffffff"
    secondaryBorderColor: "#333e48"
    tertiaryColor: "#4f4f4f"
    tertiaryTextColor: "#ffffff"
    tertiaryBorderColor: "#4f4f4f"
    lineColor: "#696969"
    textColor: "#333e48"
    mainBkg: "#9e1b32"
    nodeBkg: "#9e1b32"
    nodeBorder: "#9e1b32"
    clusterBkg: "#e7e7e7"
    clusterBorder: "#9c9c9c"
    defaultLinkColor: "#696969"
    edgeLabelBackground: "#ffffff"
    labelColor: "#ffffff"
    titleColor: "#333e48"
    sectionBkgColor: "#e7e7e7"
    altSectionBkgColor: "#cfcfcf"
    sectionBkgColor2: "#e7e7e7"
    taskBkgColor: "#9e1b32"
    taskBorderColor: "#9e1b32"
    taskTextColor: "#ffffff"
    taskTextDarkColor: "#333e48"
    taskTextLightColor: "#ffffff"
    taskTextOutsideColor: "#333e48"
    activeTaskBkgColor: "#333e48"
    activeTaskBorderColor: "#333e48"
    doneTaskBkgColor: "#4f4f4f"
    doneTaskBorderColor: "#4f4f4f"
    critBkgColor: "#9e1b32"
    critBorderColor: "#e8002a"
    excludeBkgColor: "#e7e7e7"
    gridColor: "#9c9c9c"
    todayLineColor: "#e8002a"
  themeCSS: ".node > rect, .node > circle, .node > ellipse, .node > polygon, .node > path, rect.actor, .note, .task, .task0, .task1, .task2, .task3 { stroke-width: 0 !important; }"
# mermaid: config end
# mermaid: metadata begin
mermaid:
  colorset: "colorset1"
  mode: "standard"
  palette: "basic-red-neutral-style"
# mermaid: metadata end
---
gantt
  accTitle: Gantt maximum complexity showcase
  accDescr: Six dated tasks expose every Gantt status combination from normal through done-critical.
  title Gantt semantic roles
  dateFormat YYYY-MM-DD
  section Capacity
    Normal task :normal, 2026-01-01, 1d
    Active task :active, active_task, 2026-01-02, 1d
    Done task :done, done_task, 2026-01-03, 1d
    Critical task :crit, critical_task, 2026-01-04, 1d
    Active critical task :crit, active, active_critical, 2026-01-05, 1d
    Done critical task :crit, done, done_critical, 2026-01-06, 1d
