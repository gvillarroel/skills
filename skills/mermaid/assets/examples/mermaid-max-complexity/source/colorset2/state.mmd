---
stateDiagram-v2
  accTitle: State maximum complexity showcase
  accDescr: A lifecycle advances through nine explicitly styled states from the initial marker to the terminal marker.
  direction LR
  [*] --> StateRole01
  StateRole01 --> StateRole02
  StateRole02 --> StateRole03
  StateRole03 --> StateRole04
  StateRole04 --> StateRole05
  StateRole05 --> StateRole06
  StateRole06 --> StateRole07
  StateRole07 --> StateRole08
  StateRole08 --> StateRole09
  StateRole09 --> [*]
  class StateRole01 csPrimary
  class StateRole02 csAccent
  class StateRole03 csMuted
  class StateRole04 csCritical
  class StateRole05 csWarning
  class StateRole06 csSuccess
  class StateRole07 csInfo
  class StateRole08 csSpecial
  class StateRole09 csNeutral
  classDef csPrimary fill:#ffccd5,stroke:#9e1b32,color:#333e48,stroke-width:2px;
  classDef csAccent fill:#cdf3ff,stroke:#007298,color:#333e48,stroke-width:2px;
  classDef csMuted fill:#e7e7e7,stroke:#828282,color:#333e48,stroke-width:2px;
  classDef csCritical fill:#ffccd5,stroke:#e8002a,color:#333e48,stroke-width:2px;
  classDef csWarning fill:#ffe5cc,stroke:#e77204,color:#333e48,stroke-width:2px;
  classDef csSuccess fill:#dbffcc,stroke:#45842a,color:#333e48,stroke-width:2px;
  classDef csInfo fill:#cdf3ff,stroke:#00ace6,color:#333e48,stroke-width:2px;
  classDef csSpecial fill:#f9ccff,stroke:#652f6c,color:#333e48,stroke-width:2px;
  classDef csNeutral fill:#e7e7e7,stroke:#333e48,color:#333e48,stroke-width:2px;
