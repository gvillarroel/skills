---
# mermaid: config begin
config:
  theme: "base"
  themeVariables:
    background: "#ffffff"
    primaryColor: "#9e1b32"
    primaryTextColor: "#ffffff"
    primaryBorderColor: "#9e1b32"
    secondaryColor: "#007298"
    secondaryTextColor: "#ffffff"
    secondaryBorderColor: "#007298"
    tertiaryColor: "#e77204"
    tertiaryTextColor: "#000000"
    tertiaryBorderColor: "#e77204"
    lineColor: "#696969"
    textColor: "#333e48"
    mainBkg: "#9e1b32"
    nodeBkg: "#9e1b32"
    nodeBorder: "#9e1b32"
    clusterBkg: "#e7e7e7"
    clusterBorder: "#9c9c9c"
    defaultLinkColor: "#696969"
    edgeLabelBackground: "#ffffff"
    classText: "#ffffff"
    transitionColor: "#696969"
    stateLabelColor: "#ffffff"
    stateBkg: "#007298"
    labelBackgroundColor: "#007298"
    compositeBackground: "#cdf3ff"
    altBackground: "#ffe5cc"
    compositeTitleBackground: "#cdf3ff"
    compositeBorder: "#007298"
    labelColor: "#ffffff"
    titleColor: "#333e48"
  themeCSS: ".node > rect, .node > circle, .node > ellipse, .node > polygon, .node > path, rect.actor, .note, .task, .task0, .task1, .task2, .task3 { stroke-width: 0 !important; }"
  state:
    padding: 6
    nodeSpacing: 28
    rankSpacing: 32
  flowchart:
    padding: 6
    nodeSpacing: 28
    rankSpacing: 32
    subGraphTitleMargin:
      top: 4
      bottom: 12
# mermaid: config end
# mermaid: metadata begin
mermaid:
  colorset: "colorset2"
  mode: "extended"
  palette: "full-color-style"
# mermaid: metadata end
---
stateDiagram-v2
  accTitle: State maximum complexity showcase
  accDescr: A lifecycle advances through nine explicitly styled states from the initial marker to the terminal marker.
  direction LR
  [*] --> StateRole01
  StateRole01 --> StateRole02
  StateRole02 --> StateRole03
  StateRole03 --> StateRole04
  StateRole04 --> StateRole05
  StateRole05 --> StateRole06
  StateRole06 --> StateRole07
  StateRole07 --> StateRole08
  StateRole08 --> StateRole09
  StateRole09 --> [*]
  class StateRole01 csPrimary
  class StateRole02 csAccent
  class StateRole03 csMuted
  class StateRole04 csCritical
  class StateRole05 csWarning
  class StateRole06 csSuccess
  class StateRole07 csInfo
  class StateRole08 csSpecial
  class StateRole09 csNeutral
  classDef csPrimary fill:#9e1b32,stroke:none,color:#ffffff,stroke-width:0px;
  classDef csAccent fill:#007298,stroke:none,color:#ffffff,stroke-width:0px;
  classDef csMuted fill:#e77204,stroke:none,color:#000000,stroke-width:0px;
  classDef csCritical fill:#45842a,stroke:none,color:#000000,stroke-width:0px;
  classDef csWarning fill:#652f6c,stroke:none,color:#ffffff,stroke-width:0px;
  classDef csSuccess fill:#f1c319,stroke:none,color:#000000,stroke-width:0px;
  classDef csInfo fill:#6d1222,stroke:none,color:#ffffff,stroke-width:0px;
  classDef csSpecial fill:#004d66,stroke:none,color:#ffffff,stroke-width:0px;
  classDef csNeutral fill:#994a00,stroke:none,color:#ffffff,stroke-width:0px;
