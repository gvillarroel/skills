      "cacheWriteTokens",
      "outputTokens",
      "maximumRequestInputTokens",
      "discardedContextTokens",
      "summaryOutputTokens"
    ],
    "elasticity": {
      "arcFormula": "((comparisonCost - baselineCost) / baselineCost) / ((comparisonValue - baselineValue) / baselineValue)",
      "marginalFormula": "(comparisonCost - baselineCost) / (comparisonValue - baselineValue)",
      "thresholdHandling": "Report the finite difference and a tier-switch indicator; do not interpret a discontinuity as a smooth derivative."
    }
  },
