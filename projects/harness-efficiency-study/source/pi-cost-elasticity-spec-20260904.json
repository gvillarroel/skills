{
  "schemaVersion": "1.0.0",
  "studyId": "pi-copilot-cost-elasticity-20260904",
  "title": "Offline deterministic Pi-to-GitHub-Copilot cost elasticity study",
  "asOf": "2026-09-04",
  "currency": "USD",
  "objective": "Estimate how provider token value changes when one Pi harness or session-policy variable changes while all other modeled inputs remain fixed.",
  "executionPolicy": {
    "mode": "offline-deterministic-simulation",
    "realPiExecutionsAllowed": false,
    "realCopilotExecutionsAllowed": false,
    "networkModelCallsAllowed": false,
    "randomSamplingUsed": false,
    "volumeScaling": "algebraic-only"
  },
  "scope": {
    "harness": "Pi coding agent",
    "providerRoute": "GitHub Copilot",
    "modelSelection": "fixed-manual-model-per-contrast",
    "models": [
      "gpt-5.6-luna",
      "gpt-5.6-terra",
      "gpt-5.6-sol"
    ],
    "estimand": "provider-token-value-usd",
    "excludedEstimands": [
      "empirical task quality",
      "empirical latency",
      "empirical cache hit rate",
      "empirical Pi or Copilot reliability",
      "actual monthly cash charge without a supplied account allowance state"
    ]
  },
  "rateCard": {
    "unit": "USD per 1,000,000 tokens",
    "tierRule": "Use the long-context rates for every billed token category in a request when total request input tokens are strictly greater than the model-specific Copilot threshold.",
    "inputReconciliation": "totalInputTokens = uncachedInputTokens + cacheReadTokens + cacheWriteTokens",
    "models": {
      "gpt-5.6-luna": {
        "copilotLongContextThresholdInputTokens": 200000,
        "catalogContextWindowTokens": 1050000,
        "shortRates": {
          "uncachedInput": 0.2,
          "cacheRead": 0.02,
          "cacheWrite": 0.25,
          "output": 1.2
        },
        "longRates": {
          "uncachedInput": 0.4,
          "cacheRead": 0.04,
          "cacheWrite": 0.5,
          "output": 1.8
        }
      },
      "gpt-5.6-terra": {
        "copilotLongContextThresholdInputTokens": 272000,
        "catalogContextWindowTokens": 1050000,
        "shortRates": {
          "uncachedInput": 2.0,
          "cacheRead": 0.2,
          "cacheWrite": 2.5,
          "output": 12.0
        },
        "longRates": {
          "uncachedInput": 4.0,
          "cacheRead": 0.4,
          "cacheWrite": 5.0,
          "output": 18.0
        }
      },
      "gpt-5.6-sol": {
        "copilotLongContextThresholdInputTokens": 272000,
        "catalogContextWindowTokens": 1050000,
        "shortRates": {
          "uncachedInput": 4.0,
          "cacheRead": 0.4,
          "cacheWrite": 5.0,
          "output": 20.0
        },
        "longRates": {
          "uncachedInput": 8.0,
          "cacheRead": 0.8,
          "cacheWrite": 10.0,
          "output": 30.0
        }
      }
    }
  },
  "billing": {
    "usdPerGitHubAiCredit": 0.01,
    "fixedModelAutomaticSelectionDiscountFraction": 0.0,
    "discountRationale": "GitHub documents the automatic-model-selection discount for supported Copilot clients. This study fixes the model in third-party Pi and therefore applies no automatic-selection discount.",
    "piSolCatalogDiscrepancy": "The observed Pi Sol catalog showed older lower prices than GitHub's current route billing table. The simulation uses GitHub's official table as the source of truth.",
    "providerValueFormula": "providerUsd = (uncachedInputTokens * uncachedInputRate + cacheReadTokens * cacheReadRate + cacheWriteTokens * cacheWriteRate + outputTokens * outputRate) / 1000000",
    "aiCreditsFormula": "aiCredits = providerUsd / usdPerGitHubAiCredit",
    "cashBoundary": "Provider value and AI-credit consumption are reported before plan allowances. Actual incremental cash requires the user's remaining included-credit balance and overage settings.",
    "incrementalCashFormulaWhenAllowanceIsKnown": "max(0, comparisonCredits - remainingIncludedCredits) * usdPerGitHubAiCredit - max(0, baselineCredits - remainingIncludedCredits) * usdPerGitHubAiCredit"
  },
  "cacheModel": {
    "bucketsAreMutuallyExclusive": true,
    "stablePrefixRule": "The first request cache-writes the stable prompt. Each append-only continuation cache-reads the previously written prefix and cache-writes only the newly appended suffix.",
    "uncachedRule": "Tokens deliberately modeled as non-reusable are charged at uncached-input rates and are not also counted as cache reads or writes.",
    "toolArgumentRule": "Tool-call arguments are output tokens when generated and become part of the appended input suffix, together with the tool result, on the next request.",
    "prefixChurnRule": "A mutation before the reusable-prefix boundary invalidates downstream reuse; the affected full prompt is cache-written again.",
    "modelSwitchRule": "No scenario switches models inside an execution because model switches can invalidate the provider cache and would confound the fixed-model contrasts.",
    "idleExpiryRule": "No idle expiry is modeled; a dedicated prefix-churn contrast represents the conservative all-cold boundary."
  },
  "piCompactionFacts": {
    "catalogContextWindowTokens": 1050000,
    "defaultReserveTokens": 16384,
    "defaultKeepRecentTokens": 20000,
    "defaultAutomaticTriggerFormula": "contextWindowTokens - reserveTokens",
    "defaultAutomaticTriggerTokens": 1033616,
    "cap200kIsDefault": false,
    "cap200kImplementationInterpretation": "A 200,000-token strategy requires manual or custom compaction, or an effective configured context window of approximately 216,384 tokens when the default 16,384-token reserve is retained.",
    "compactionCall": "Compaction is an additional model request that consumes the pre-compaction context and emits a summary.",
    "freshRoutingSession": "Pi compaction requests use a fresh routing-session identifier and disable cache writes where supported; the primary simulation therefore charges compaction input as uncached and the next main request as a cold cache write.",
    "availabilityCaveat": "Pi's model catalog exposes a 1,050,000-token window, but GitHub's public one-million-token context guarantee is documented for VS Code and Copilot CLI rather than third-party Pi. The 800,000-token path is a conditional theoretical scenario, not a verified service guarantee."
  },
