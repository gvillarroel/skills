  "qualityBreakEven": {
    "purpose": "Translate simulated token savings into the maximum tolerable quality or rework penalty; do not claim an empirical quality effect.",
    "lossPerDegradedExecutionUsdGrid": [
      10,
      50,
      100,
      500,
      1000
    ],
    "decisionRule": "Prefer the lower-token-cost policy only when tokenSavingsUsdPerExecution exceeds expectedAdditionalQualityLossUsd plus expectedAdditionalHumanReworkUsd plus expectedAdditionalLatencyUsd plus implementationOverheadUsd.",
    "expectedQualityLossFormula": "degradationProbability * lossPerDegradedExecutionUsd",
    "breakEvenProbabilityFormula": "max(0, tokenSavingsUsdPerExecution - otherIncrementalPenaltyUsd) / lossPerDegradedExecutionUsd",
    "independentPerCompactionProbabilityFormula": "max(0, tokenSavingsUsdPerExecution - otherIncrementalPenaltyUsd) / (compactionsPerExecution * lossPerDegradedCompactionUsd)",
    "interpretation": "Use the per-execution probability when degradation is assessed once per session. Use the per-compaction probability only when each compaction independently risks the full declared loss. Below the applicable threshold the compact policy has lower modeled total cost; above it the uncompacted policy has lower modeled total cost."
  },
  "validationRequirements": [
    "Every request reconciles total input to exactly one of uncached input, cache read, or cache write.",
    "Every baseline/comparison pair changes only its declared decision variable; downstream token and request counts may change mechanically.",
    "The long tier activates only for request input strictly greater than the model-specific Copilot threshold.",
    "The threshold-crossing fixture is 500 tokens below versus 500 tokens above its model threshold.",
    "The 200,000-token compaction fixture produces 39 main requests, four compaction requests, and no main request above 200,000 tokens.",
    "Scaling to 1,000 and 1,000,000 executions equals per-execution values multiplied by the volume; no rows are materialized per execution.",
    "An independent validator recomputes costs from token ledgers rather than trusting summary values.",
    "Scenario labels have no effect on modeled behavior."
  ],
  "inferenceBoundary": "This simulation identifies accounting consequences of declared token-flow assumptions. It does not establish the actual cache behavior, context availability, task quality, or overall superiority of Pi, GitHub Copilot, or any model.",
