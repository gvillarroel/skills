  "preset_contract": "Supply every listed column for a preset or omit data for labelled synthetic defaults. Grouped values are rows by series; grid z is y rows by x columns. Uncertainty lower/upper are absolute bounds. Sankey links are [source,target,value] triples; nodes are ordered labels.",
  "generic_contract": {
    "version": 1,
    "factory": "allowlisted factory",
    "args": "optional positional JSON arguments for factory-owned data",
    "data": "optional named equal-length array columns",
    "marks": [
      {
        "kind": "allowlisted mark",
        "args": [],
        "kwargs": {}
      }
    ],
    "components": [
      {
        "kind": "allowlisted component",
        "args": [],
        "kwargs": {}
      }
    ],
    "options": "public chart/factory keyword arguments; consult focused skill references",
    "width": 960,
    "height": 540
  },
