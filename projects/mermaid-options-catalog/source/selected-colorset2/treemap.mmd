---
# mermaid: config begin
config:
  theme: "base"
  themeVariables:
    background: "#ffffff"
    primaryColor: "#ffccd5"
    primaryTextColor: "#333e48"
    primaryBorderColor: "#9e1b32"
    secondaryColor: "#cdf3ff"
    secondaryTextColor: "#333e48"
    secondaryBorderColor: "#007298"
    tertiaryColor: "#e7e7e7"
    tertiaryTextColor: "#333e48"
    tertiaryBorderColor: "#9c9c9c"
    lineColor: "#696969"
    textColor: "#333e48"
    mainBkg: "#cdf3ff"
    nodeBkg: "#cdf3ff"
    nodeBorder: "#9e1b32"
    clusterBkg: "#e7e7e7"
    clusterBorder: "#9c9c9c"
    defaultLinkColor: "#696969"
    edgeLabelBackground: "#ffffff"
    classText: "#333e48"
    labelColor: "#333e48"
    titleColor: "#333e48"
    cScale0: "#9e1b32"
    cScale1: "#007298"
    cScale2: "#e77204"
    cScale3: "#45842a"
    cScale4: "#652f6c"
    cScale5: "#828282"
    cScale6: "#4f4f4f"
    cScale7: "#e8002a"
    cScaleLabel0: "#ffffff"
    cScaleLabel1: "#ffffff"
    cScaleLabel2: "#ffffff"
    cScaleLabel3: "#ffffff"
    cScaleLabel4: "#ffffff"
    cScaleLabel5: "#ffffff"
    cScaleLabel6: "#ffffff"
    cScaleLabel7: "#ffffff"
    cScaleInv0: "#ffccd5"
    cScaleInv1: "#cdf3ff"
    cScaleInv2: "#ffe5cc"
    cScaleInv3: "#dbffcc"
    cScaleInv4: "#f9ccff"
    cScaleInv5: "#cfcfcf"
    cScaleInv6: "#b5b5b5"
    cScaleInv7: "#ffccd5"
  themeCSS: ".treemapLeaf { fill-opacity: 0.5 !important; stroke-width: 6px !important; }"
  treemap:
    useMaxWidth: false
    padding: 4
    diagramPadding: 8
    nodeWidth: 200
    nodeHeight: 65
# mermaid: config end
# mermaid: metadata begin
mermaid:
  colorset: "colorset2"
  mode: "extended"
  palette: "full-color-style"
# mermaid: metadata end
---
treemap-beta
  "Base"
    "Primary": 10:::csPrimary
    "Accent": 8:::csAccent
    "Critical": 4:::csCritical
  classDef csPrimary fill:#ffccd5,stroke:#9e1b32,color:#333e48,stroke-width:2px;
  classDef csAccent fill:#cdf3ff,stroke:#007298,color:#333e48,stroke-width:2px;
  classDef csCritical fill:#ffccd5,stroke:#e8002a,color:#333e48,stroke-width:2px;
