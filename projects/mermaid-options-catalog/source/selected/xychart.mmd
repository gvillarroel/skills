---
# mermaid: config begin
config:
  theme: "base"
  themeVariables:
    background: "#ffffff"
    primaryColor: "#ffccd5"
    primaryTextColor: "#333e48"
    primaryBorderColor: "#9e1b32"
    secondaryColor: "#e7e7e7"
    secondaryTextColor: "#333e48"
    secondaryBorderColor: "#4f4f4f"
    tertiaryColor: "#e7e7e7"
    tertiaryTextColor: "#333e48"
    tertiaryBorderColor: "#9c9c9c"
    lineColor: "#696969"
    textColor: "#333e48"
    mainBkg: "#ffccd5"
    nodeBkg: "#ffccd5"
    nodeBorder: "#9e1b32"
    clusterBkg: "#e7e7e7"
    clusterBorder: "#9c9c9c"
    defaultLinkColor: "#696969"
    edgeLabelBackground: "#ffffff"
    labelColor: "#333e48"
    titleColor: "#333e48"
    xyChart:
      backgroundColor: "#ffffff"
      titleColor: "#333e48"
      xAxisLabelColor: "#333e48"
      xAxisTitleColor: "#333e48"
      xAxisTickColor: "#696969"
      xAxisLineColor: "#696969"
      yAxisLabelColor: "#333e48"
      yAxisTitleColor: "#333e48"
      yAxisTickColor: "#696969"
      yAxisLineColor: "#696969"
      plotColorPalette: "#9e1b32, #4f4f4f, #828282, #333e48, #696969"
# mermaid: config end
# mermaid: metadata begin
mermaid:
  colorset: "colorset1"
  mode: "standard"
  palette: "basic-red-neutral-style"
# mermaid: metadata end
---
xychart
  title "Base XY chart"
  x-axis [A, B, C]
  y-axis "Value" 0 --> 10
  bar [2, 5, 8]
  line [1, 4, 7]
