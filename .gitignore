# Dependencies
node_modules/
**/node_modules/

# Locally installed Codex skills
/.agents/

# Local browser/runtime caches
.playwright-cli/
playwright-report/
test-results/
.cache/
.vite/
**/.vite/

# Python/tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/

# Environment and logs
.env
.env.*
!.env.example
*.log

# Generated verification output and local builds
/output/
/docs/
/examples/
dist/

# Local evaluation runs and generated datasets
/results/
/evaluations/runs/
/evaluations/**/raw/**
/evaluations/**/processed/**

# Keep lightweight dataset documentation and control metadata versionable even
# when it lives beside ignored evaluation data.
!/evaluations/**/raw/**/
!/evaluations/**/processed/**/
!/evaluations/**/raw/**/.gitkeep
!/evaluations/**/processed/**/.gitkeep
!/evaluations/**/raw/**/README.md
!/evaluations/**/processed/**/README.md
!/evaluations/**/raw/**/manifest.json
!/evaluations/**/processed/**/manifest.json
!/evaluations/**/raw/**/manifest.yaml
!/evaluations/**/processed/**/manifest.yaml
!/evaluations/**/raw/**/manifest.yml
!/evaluations/**/processed/**/manifest.yml
!/evaluations/**/raw/**/schema.json
!/evaluations/**/processed/**/schema.json
!/evaluations/**/raw/**/*.schema.json
!/evaluations/**/processed/**/*.schema.json
!/evaluations/**/raw/**/config.json
!/evaluations/**/processed/**/config.json
!/evaluations/**/raw/**/config.yaml
!/evaluations/**/processed/**/config.yaml
!/evaluations/**/raw/**/config.yml
!/evaluations/**/processed/**/config.yml
!/evaluations/**/raw/**/config.toml
!/evaluations/**/processed/**/config.toml

# Project-scoped generated artifacts
/projects/*/artifacts/
/projects/*/work/
/projects/*/cache/
/projects/**/artifacts/
/projects/**/work/
/projects/**/cache/
/projects/**/contact-sheets/

# Rendered media should be published outside git.
*.mp4
*.webm
*.mov
*.avi
*.mkv
*.gif
*.apng

# OS metadata
.DS_Store
Thumbs.db
